# Copy to .env and fill in. .env is git-ignored: never commit your token.

# The Incorta MCP server endpoint (Streamable HTTP), e.g. https://<host>/mcp
INCORTA_MCP_URL=

# Your Incorta details, sent to the MCP server as request headers
INCORTA_ENV_URL=https://your-cluster.cloud.incorta.com/incorta
INCORTA_TENANT=
INCORTA_TOKEN=
# Only needed for run_sql
INCORTA_ACCOUNT_ID=

# Where this server listens
PORT=8787
HOST=127.0.0.1
